include LICENSE
include README.md
include pyproject.toml
include MANIFEST.in
include reconstruct.py
include reproduce/benchmark_main.py
include reproduce/benchmark_main.sh
recursive-include revise *.py
recursive-include revise/application/templates *.yaml
