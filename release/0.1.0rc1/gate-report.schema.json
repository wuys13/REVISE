{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wuys13/REVISE/releases/0.1.0rc1/gate-report.schema.json",
  "title": "REVISE CI gate report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate",
    "conclusion",
    "head_sha",
    "run_id",
    "run_attempt",
    "run_url",
    "tested_python",
    "runner",
    "os",
    "architecture"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "gate": {"enum": ["unit", "integration", "installed_cli", "package", "docs", "repository", "tacco"]},
    "conclusion": {"const": "success"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "run_id": {"type": "integer", "minimum": 1},
    "run_attempt": {"type": "integer", "minimum": 1},
    "run_url": {"type": "string", "format": "uri", "pattern": "^https://[^\\s]+$"},
    "tested_python": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["3.10", "3.11"]}
    },
    "runner": {"const": "ubuntu-latest"},
    "os": {"type": "string", "minLength": 1},
    "architecture": {"type": "string", "minLength": 1}
  }
}
