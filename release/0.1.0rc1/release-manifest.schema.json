{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wuys13/REVISE/releases/0.1.0rc1/release-manifest.schema.json",
  "title": "REVISE detached release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release",
    "source",
    "build",
    "artifacts",
    "ci",
    "docs",
    "support",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "version", "tag", "channel"],
      "properties": {
        "project": {"const": "revise-svc"},
        "version": {"type": "string", "pattern": "^0\\.1\\.0rc[0-9]+$"},
        "tag": {"type": "string", "pattern": "^v0\\.1\\.0rc[0-9]+$"},
        "channel": {"enum": ["candidate", "stable"]}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree"],
      "properties": {
        "repository": {"const": "https://github.com/wuys13/REVISE"},
        "commit": {"$ref": "#/$defs/git_object"},
        "tree": {"$ref": "#/$defs/git_object"}
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_run",
        "python",
        "backend",
        "tools",
        "isolation",
        "constraints"
      ],
      "properties": {
        "workflow_run": {"type": "string", "format": "uri", "pattern": "^https://[^\\s]+$"},
        "python": {
          "type": "object",
          "additionalProperties": false,
          "required": ["implementation", "version"],
          "properties": {
            "implementation": {"const": "CPython"},
            "version": {"type": "string", "pattern": "^3\\.(10|11)\\.[0-9]+$"}
          }
        },
        "backend": {"const": "setuptools.build_meta"},
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": ["setuptools", "wheel"],
          "properties": {
            "setuptools": {"const": "80.9.0"},
            "wheel": {"const": "0.45.1"}
          }
        },
        "isolation": {"const": false},
        "constraints": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/constraint"}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/artifact"},
      "allOf": [
        {"contains": {"properties": {"role": {"const": "wheel"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"role": {"const": "sdist"}}}, "minContains": 1, "maxContains": 1}
      ]
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head_sha", "gates"],
      "properties": {
        "head_sha": {"$ref": "#/$defs/git_object"},
        "gates": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {"$ref": "#/$defs/gate"},
          "allOf": [
            {"contains": {"properties": {"id": {"const": "unit"}}}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"id": {"const": "integration"}}}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"id": {"const": "installed_cli"}}}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"id": {"const": "package"}}}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"id": {"const": "docs"}}}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"id": {"const": "repository"}}}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"id": {"const": "tacco"}}}, "minContains": 1, "maxContains": 1}
          ]
        }
      }
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_commit", "version", "channel", "workflow_run"],
      "properties": {
        "source_commit": {"$ref": "#/$defs/git_object"},
        "version": {"type": "string", "pattern": "^0\\.1\\.0rc[0-9]+$"},
        "channel": {"const": "candidate"},
        "workflow_run": {"type": "string", "format": "uri", "pattern": "^https://[^\\s]+$"}
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tested_python",
        "tested_platforms",
        "available_extras",
        "tested_extras"
      ],
      "properties": {
        "tested_python": {"const": ["3.10", "3.11"]},
        "tested_platforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["runner", "os", "architecture"],
            "properties": {
              "runner": {"const": "ubuntu-latest"},
              "os": {"type": "string", "minLength": 1},
              "architecture": {"type": "string", "minLength": 1}
            }
          }
        },
        "available_extras": {
          "const": ["cci", "dev", "pathway", "spatialdata", "tacco", "trajectory"]
        },
        "tested_extras": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["cci", "dev", "pathway", "spatialdata", "tacco", "trajectory"]}
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/limitation"}
    }
  },
  "$defs": {
    "git_object": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safe_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "path", "sha256"],
      "properties": {
        "python": {"enum": ["3.10", "3.11"]},
        "path": {"type": "string", "pattern": "^constraints/python-3\\.(10|11)\\.txt$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "filename", "size", "sha256"],
      "properties": {
        "role": {"enum": ["wheel", "sdist"]},
        "filename": {
          "type": "string",
          "pattern": "^(?!.*release-manifest)(?!.*[/\\\\]).+\\.(whl|tar\\.gz)$"
        },
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {"properties": {"role": {"const": "wheel"}}},
          "then": {"properties": {"filename": {"pattern": "\\.whl$"}}}
        },
        {
          "if": {"properties": {"role": {"const": "sdist"}}},
          "then": {"properties": {"filename": {"pattern": "\\.tar\\.gz$"}}}
        }
      ]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "conclusion",
        "run_id",
        "run_attempt",
        "head_sha",
        "report",
        "sha256"
      ],
      "properties": {
        "id": {"enum": ["unit", "integration", "installed_cli", "package", "docs", "repository", "tacco"]},
        "conclusion": {"const": "success"},
        "run_id": {"type": "integer", "minimum": 1},
        "run_attempt": {"type": "integer", "minimum": 1},
        "head_sha": {"$ref": "#/$defs/git_object"},
        "report": {"$ref": "#/$defs/safe_path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "source"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "statement": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/safe_path"}
      }
    }
  }
}
